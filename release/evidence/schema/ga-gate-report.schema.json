{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrath.dev/schemas/ga-gate-report-v1.json",
  "title": "OpenRath GA gate report",
  "type": "object",
  "required": [
    "schema",
    "gate",
    "source_commit",
    "result",
    "generated_at",
    "environment",
    "evidence",
    "open_risks",
    "details"
  ],
  "properties": {
    "schema": {
      "const": "openrath.ga-gate-report/1"
    },
    "gate": {
      "enum": [
        "tests",
        "live_adapters",
        "performance",
        "soak",
        "drills",
        "compatibility"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result": {
      "const": "passed"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_risks": {
      "type": "array"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
