{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrath.dev/schemas/rc-evidence-manifest.json",
  "title": "OpenRath RC evidence manifest",
  "type": "object",
  "required": [
    "schema",
    "release_stage",
    "version",
    "tag",
    "source_commit",
    "source_tree_clean",
    "ga_approved",
    "artifacts",
    "blocking_gates"
  ],
  "properties": {
    "schema": {"const": "openrath.rc-evidence/1"},
    "release_stage": {"const": "rc"},
    "version": {"type": "string", "pattern": "^2\\.0\\.0rc[0-9]+$"},
    "tag": {"type": "string", "pattern": "^v2\\.0\\.0rc[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_clean": {"const": true},
    "ga_approved": {"const": false},
    "artifacts": {"type": "object"},
    "blocking_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
